          <zeebe:input source="={reward : string}" target="rewardDescription" />
          <zeebe:input source="={name : string}" target="taskCreator" />
          <zeebe:output source="={&#10;  &#34;name&#34;: &#34;${rewardName}&#34;,&#10;  &#34;description&#34;: &#34;${rewardDescription}&#34;,&#10;  &#34;creatorOfTask&#34;: &#34;${taskCreator}&#34;&#10;}&#10;" target="rewardDetails" />
